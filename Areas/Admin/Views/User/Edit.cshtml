@model Equinox.Models.User
@{
    ViewData["Title"] = "Edit User";
}

<h2>@ViewData["Title"]</h2>

@if(TempData["ValidationErrors"] != null)
{
    <div class="alert alert-danger">@TempData["ValidationErrors"]</div>
}

<form asp-action="Edit" asp-route-id="@Model.UserId" method="post">
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" placeholder="(555) 123-4567" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DOB">Date of Birth</label>
        <input asp-for="DOB" type="date" class="form-control" />
        <span asp-validation-for="DOB" class="text-danger"></span>
        <small class="form-text text-muted">Age must be between 8 and 80 years</small>
    </div>
    <div class="form-group form-check">
        <input asp-for="IsCoach" class="form-check-input" />
        <label asp-for="IsCoach" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/age-range.js"></script>
}
